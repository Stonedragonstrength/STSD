<?xml version="1.0" encoding="utf-8"?>
<!-- No android:configure on purpose. A configure activity has to hand back
     RESULT_OK with the widget id or the launcher silently drops the widget,
     and it would demand a password before the coach has seen what they placed.
     The widget places straight away and its empty state is "Tap to sign in",
     which opens the same screen with none of that contract to get wrong.

     updatePeriodMillis is clamped by Android to 30 minutes; anything smaller is
     ignored, so it is written as the real value rather than as a wish. The
     header's ⟳ and every day-step also fetch, which is what covers the gap. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_schedule"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
