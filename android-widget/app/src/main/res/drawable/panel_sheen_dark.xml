<?xml version="1.0" encoding="utf-8"?>
<!-- A light wash across the top of the panel, so the surface has a direction
     instead of being a flat slab.

     Alpha only — white fading to nothing — so it is ACCENT-INDEPENDENT. Baking
     it per accent would mean eight of these to keep in step with Theme, and a
     ninth accent later would silently have no sheen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <!-- Cut from 12% to 2.5% 2026-08-08: at 12% it was "light flaring from
         the top" on a panel that is supposed to be intensely black. A breath
         of direction remains so the surface doesn't go dead flat. -->
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#06FFFFFF"
        android:centerColor="#02FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
