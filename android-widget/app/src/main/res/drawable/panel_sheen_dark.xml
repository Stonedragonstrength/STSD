<?xml version="1.0" encoding="utf-8"?>
<!-- A light wash across the top of the panel, so the surface has a direction
     instead of being a flat slab.

     Alpha only — white fading to nothing — so it is ACCENT-INDEPENDENT. Baking
     it per accent would mean eight of these to keep in step with Theme, and a
     ninth accent later would silently have no sheen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#1FFFFFFF"
        android:centerColor="#0AFFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
