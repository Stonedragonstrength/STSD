<?xml version="1.0" encoding="utf-8"?>
<!-- A soft glow in the top-left corner, tinted at runtime with the coach's
     chosen accent (ImageView.setColorFilter is remotable; a drawable tint is
     not, below API 31). Drawn WHITE here so the filter has something neutral to
     colour — a pre-tinted gradient would multiply into mud.

     This is what ties the surface to the accent without painting the whole panel
     with it: at 20% in one corner it reads as light coming from somewhere,
     which is the difference between a themed object and a coloured rectangle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="radial"
        android:gradientRadius="70%p"
        android:centerX="0.12"
        android:centerY="0.05"
        android:startColor="#33FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
