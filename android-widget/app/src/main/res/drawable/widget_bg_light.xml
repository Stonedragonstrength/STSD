<?xml version="1.0" encoding="utf-8"?>
<!-- The light surface. Same shape and same near-opaque alpha as widget_bg, so
     switching between them changes only the colour and never the silhouette
     sitting on the home screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F2F6FA" />
    <corners android:radius="20dp" />
</shape>
