<?xml version="1.0" encoding="utf-8"?>
<!-- Time on the left in a fixed column so the names line up down the list —
     a ragged left edge is what makes a schedule hard to scan.

     The row used to be two lines always: a name, and under it a meta line that
     usually said nothing but "60m". Across a week that is a wasted line per
     session and about a third of the visible schedule. The duration moved into
     the time column, which had spare height and no second line, and the meta
     line is now hidden unless there is a note — so an ordinary session is one
     line and only the ones with something to say cost two. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- The athlete's own colour — the same one their avatar carries in the app,
         so a session is recognisable as theirs before the name is read.

         A background colour rather than a bitmap: setBackgroundColor is
         remotable, and a bitmap per row would blow the RemoteViews transaction
         budget on exactly the busy weeks that matter most.

         And a FrameLayout rather than a plain View: RemoteViews accepts only a
         fixed list of view classes and `View` is not on it. Lint calls that an
         error, and on the device it is an inflate failure, not a cosmetic one.
         An empty layout is the lightest thing on that list which can carry a
         background. -->
    <FrameLayout
        android:id="@+id/row_edge"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="#00000000" />

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="6:00a"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/row_dur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="60m"
            android:textSize="10sp"
            android:textColor="@color/muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Athlete"
            android:textSize="14sp"
            android:textColor="@color/text" />

        <!-- Notes only, and GONE when there is no note. -->
        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/muted" />
    </LinearLayout>
</LinearLayout>
