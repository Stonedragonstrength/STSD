<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_blurb"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/cfg_signed_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="14sp"
        android:textColor="@color/accent"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/cfg_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/cfg_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/cfg_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sign_in" />

    <TextView
        android:id="@+id/cfg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:paddingTop="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_footer"
        android:textSize="11sp"
        android:textColor="@color/muted"
        android:paddingTop="28dp" />
</LinearLayout>
