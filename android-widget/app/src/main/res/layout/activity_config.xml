<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls: the form plus a diagnostic report is taller than a phone. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_blurb"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/cfg_signed_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="14sp"
        android:textColor="@color/accent"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/cfg_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/cfg_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/cfg_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sign_in" />

    <TextView
        android:id="@+id/cfg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:paddingTop="14dp" />

    <!-- Appearance. The swatches are built in code rather than declared here:
         ten of them is a lot of near-identical XML, and the palette already
         exists once in Theme.kt — declaring it again is one more place for the
         widget and its picker to disagree about what "Teal" is. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appearance"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:layout_marginTop="26dp" />

    <!-- Vertical: buildSwatches fills it with rows of five. Ten dots in ONE
         row is 380dp, wider than a phone, so the last few sat off the edge of
         the screen with no way to reach them — a LinearLayout clips, it does
         not scroll. Two rows fit any handset and hide nothing. -->
    <LinearLayout
        android:id="@+id/cfg_swatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/light_background"
            android:textSize="14sp"
            android:textColor="@color/text" />

        <Switch
            android:id="@+id/cfg_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/cfg_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/test_connection"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/cfg_diag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/text"
        android:paddingTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_footer"
        android:textSize="11sp"
        android:textColor="@color/muted"
        android:paddingTop="28dp" />
</LinearLayout>
</ScrollView>
