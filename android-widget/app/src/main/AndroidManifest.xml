<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StoneDragonSchedule">

        <!-- Sign-in, and the only launcher entry. Reached from the app drawer or
             from the widget's "Tap to sign in". -->
        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ScheduleWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The day-paging and refresh taps come back as broadcasts to
                     this same receiver, so they have to be declared here or
                     onReceive never sees them. -->
                <action android:name="com.stonedragon.schedule.PREV" />
                <action android:name="com.stonedragon.schedule.NEXT" />
                <action android:name="com.stonedragon.schedule.TODAY" />
                <action android:name="com.stonedragon.schedule.REFRESH" />
                <action android:name="com.stonedragon.schedule.OPEN" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- BIND_REMOTEVIEWS keeps this callable by the launcher and nothing
             else; without it the list silently stays empty. -->
        <service
            android:name=".ScheduleWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>
</manifest>
